{
  "name": "playwright-test-automation-portfolio",
  "version": "2.1.0",
  "private": true,
  "description": "Professional UI, API, mobile and framework-capability automation portfolio using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:framework": "playwright test --project=framework",
    "test:authenticated": "playwright test --project=authenticated-chromium",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:data-driven": "playwright test --grep @dataDriven --project=framework",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:trace": "playwright test --trace on",
    "test:workers:1": "playwright test --workers=1",
    "test:workers:4": "playwright test --workers=4",
    "test:shard:1": "playwright test --shard=1/2",
    "test:shard:2": "playwright test --shard=2/2",
    "test:repeat": "playwright test --repeat-each=2",
    "test:last-failed": "playwright test --last-failed",
    "test:visual": "playwright test tests/framework/visual.spec.ts --project=framework",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.1",
    "typescript": "^5.9.2"
  }
}
